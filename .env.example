# Конфигурация сервера карт (docker-compose).
# Скопируйте в .env и подставьте реальные значения. .env в git не хранится.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=alpinequest
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=alpinequest

# --- API ---
# Внутри compose-сети хост базы = db. Пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://alpinequest:change-me-in-production@db:5432/alpinequest
JWT_SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Вход в API обязателен, пока нет VPN. Режим одного пользователя включать только явно.
AUTH_DISABLED=false

# --- Диски с данными (bind-mount в контейнеры) ---
# На сервере по плану это /srv/tiles и /srv/regions.
TILES_DIR=/srv/tiles
REGIONS_DIR=/srv/regions

# --- nginx / доступ снаружи ---
# CIDR-ы, которым разрешён вход, через запятую. 127.0.0.1/32 — для локали.
# В релизе сюда прописывается подсеть туннеля «Континент» (см. docs/release-vpn.md).
ALLOWED_CIDRS=127.0.0.1/32,192.168.0.0/16
# Публичное имя сервера: используется в стилях карт и абсолютных URL.
PUBLIC_HOST=maps.dev.local
# Адрес тайлов для клиентов; по умолчанию https://PUBLIC_HOST/tiles.
# Должен совпадать с адресом, с которым опубликованы стили (publish_styles.sh).
#TILES_PUBLIC_URL=https://maps.dev.local/tiles
# Пути к TLS-сертификату внутри контейнера nginx.
TLS_CERT=/etc/nginx/tls/server.crt
TLS_KEY=/etc/nginx/tls/server.key

# --- Офлайн-регионы (лимиты) ---
REGION_MAX_BYTES=524288000
REGION_MAX_ZOOM=17
REGION_MAX_PER_HOUR=5
REGION_TTL_HOURS=24
REGION_MAX_PARALLEL=2
