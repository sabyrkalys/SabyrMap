# Единственная точка входа снаружи. Подставляются только ${PUBLIC_HOST},
# ${TLS_CERT}, ${TLS_KEY} (envsubst в entrypoint.sh). Переменные nginx ($host,
# $uri, $scheme и т.п.) остаются как есть.

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    # Весь http перенаправляем на https.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Список разрешённых подсетей (генерируется из ALLOWED_CIDRS при старте).
    include /etc/nginx/allowed_cidrs.conf;

    client_max_body_size 4m;

    # Тайлы: проксируем в Martin, агрессивно кешируем на диске nginx.
    location /tiles/ {
        proxy_pass http://martin:3000/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Cache-Status $upstream_cache_status;
    }

    # API (метки, треки, каталог карт, регионы).
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Отдача файлов офлайн-регионов. Только внутренний редирект из API
    # (X-Accel-Redirect), напрямую снаружи недоступно.
    location /regions-files/ {
        internal;
        alias /srv/regions/;
        limit_rate 20m;
    }

    access_log /var/log/nginx/access.log combined;
}
